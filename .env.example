# =====================================================================
# SWA AI — Environment Configuration Template
# =====================================================================
# Copy this file to .env and configure appropriate values.
# NEVER commit real credentials, secret tokens, or API keys to git.

# Server & Network Configuration
SWA_HOST=127.0.0.1
SWA_PORT=8000
SWA_LOG_LEVEL=info
SWA_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SWA_FORCE_HSTS=0

# Application Security & Authentication
SWA_AUTH_ENABLED=false
SWA_API_KEY=change_me_to_a_secure_random_api_key_for_production
SWA_SECRET_KEY=change_this_to_a_secure_random_string_in_production
SWA_RATE_LIMIT_ENABLED=true
# Bearer token required for remote /api/* access when SWA_AUTH_ENABLED=true
SWA_API_TOKEN=
# Master encryption key (urlsafe base64, 32 bytes) for the credential vault.
# If unset, SWA AI auto-generates a local keyfile (.swa_master.key) outside git.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SWA_ENCRYPTION_KEY=

# Database Configuration
SWA_DB_PATH=swa_data.db

# Scope & Lab Mode Configuration
SWA_LAB_MODE=false
SWA_ALLOWED_TARGETS_FILE=config/targets.json

# Scan Execution Limits
SWA_DEFAULT_CONCURRENCY=5
SWA_DEFAULT_MAX_DEPTH=2
SWA_SCAN_TIMEOUT_SEC=60

# AI Security & Provider Configuration
# Supported providers: auto, openai, anthropic, gemini, openrouter, ollama
SWA_AI_PROVIDER=auto
SWA_AI_MODEL=minimax/minimax-m3.1-flash:free
SWA_AI_API_KEY=your_api_key_here
SWA_AI_BASE_URL=https://openrouter.ai/api/v1
