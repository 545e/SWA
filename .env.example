# =====================================================================
# SWA AI — Environment Configuration Template
# =====================================================================
# Copy this file to .env and configure appropriate values.
# NEVER commit real credentials, secret tokens, or API keys to git.

# Server Configuration
SWA_HOST=127.0.0.1
SWA_PORT=8000
SWA_LOG_LEVEL=info

# Scope & Lab Mode Configuration
SWA_LAB_MODE=false
SWA_ALLOWED_TARGETS_FILE=config/targets.json

# Scan Execution Limits
SWA_DEFAULT_CONCURRENCY=5
SWA_DEFAULT_MAX_DEPTH=2
SWA_SCAN_TIMEOUT_SEC=60

# Optional AI Provider Configuration
# Supported providers: auto, openai, anthropic, gemini, openrouter, ollama
SWA_AI_PROVIDER=auto
SWA_AI_MODEL=minimax/minimax-m3.1-flash:free
SWA_AI_API_KEY=your_api_key_here
SWA_AI_BASE_URL=https://openrouter.ai/api/v1

# Security & Session Secrets
SWA_SECRET_KEY=change_this_to_a_secure_random_string_in_production
